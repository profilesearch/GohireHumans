# GoHireHumans API — Environment Variables
# Copy this file to .env and fill in your values

# Port (Railway sets this automatically)
PORT=8080

# Flask debug mode (set to false in production)
FLASK_DEBUG=false

# Database path (SQLite file location).
# In production set this to /app/data/agentwork.db so it lives on the Railway volume.
DATABASE_PATH=agentwork.db

# Secret for the /seed endpoint (required to enable seeding).
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Leave empty to disable the /seed endpoint entirely (recommended for production
# after the initial seed).
SEED_SECRET=

# CORS allowed origins (comma-separated).
# IMPORTANT: do NOT use "*" in production — server.py refuses wildcard with credentials.
# For local dev, point at your frontend dev server.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Stripe integration (leave empty to use simulated payments).
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Frontend URL (for Stripe redirect URLs)
FRONTEND_URL=https://www.gohirehumans.com

# Google OAuth (leave empty to use simulated OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Transactional email and marketplace notification maintenance ──
# Resend API key used for welcome and durable marketplace email delivery.
RESEND_API_KEY=
EMAIL_FROM=GoHireHumans <hello@gohirehumans.com>
# Signing secret (whsec_...) from the Resend webhook endpoint configuration.
# Webhook target: https://gohirehumans-production.up.railway.app/webhooks/resend
RESEND_WEBHOOK_SECRET=

# AgentMail application-notification pilot. ALL gates must be explicitly set.
# Default disabled: installing a key alone never permits AgentMail sending.
# See design/agentmail-activation.md before changing production configuration.
# Existing Resend compatibility remains selected unless explicitly changed.
EMAIL_PROVIDER=resend
AGENTMAIL_SEND_ENABLED=false
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=gohirehumans.operations@agentmail.to
# Exact comma-separated approved addresses; no wildcard or implicit recipients.
AGENTMAIL_RECIPIENT_ALLOWLIST=
# First increment supports new_application only; no reminders/welcome/marketing.
AGENTMAIL_NOTIFICATION_TYPES=
# Capture these from authenticated admin notification-health at cutover.
AGENTMAIL_OUTBOX_HIGHWATER=
AGENTMAIL_NOTIFICATION_HIGHWATER=
# UTC YYYY-MM-DDTHH:MM:SSZ; only fresh post-activation events may enroll.
AGENTMAIL_ACTIVATED_AT=
# Total is lifetime ledger attempts, NOT reset daily. Default permits one canary.
AGENTMAIL_DAILY_SEND_CAP=1
AGENTMAIL_TOTAL_SEND_CAP=1

# Production defaults to enabled. Set false only for an intentional maintenance pause.
NOTIFICATION_MAINTENANCE_WORKER_ENABLED=true
# Bounded to 15..3600 seconds by server.py.
EMAIL_OUTBOX_WORKER_INTERVAL_SECONDS=60

# ── Logging ──
LOG_LEVEL=INFO
LOG_FORMAT=json
